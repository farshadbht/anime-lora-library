import json
from pathlib import Path
from urllib.parse import quote
from html import escape

ROOT = Path("downloads")
CONFIG = ROOT / "library.json"


def local_url(path):
    return "/".join(quote(part) for part in path.parts)


def get_model_info(folder):
    metadata_path = folder / "Metadata.json"

    if not metadata_path.exists():
        return [], "Unknown", None

    data = json.loads(metadata_path.read_text(encoding="utf-8"))

    checkpoints = data.get("baseModels", [])

    if not checkpoints:
        versions_folder = folder / "Versions"
        if versions_folder.exists():
            for version_file in versions_folder.glob("*/VersionMetadata.json"):
                version_data = json.loads(
                    version_file.read_text(encoding="utf-8")
                )
                base = version_data.get("baseModel")
                if base and base not in checkpoints:
                    checkpoints.append(base)

    artist = data.get("creator", {}).get("username", "Unknown")

    return checkpoints, artist, data


def generate():
    data = json.loads(CONFIG.read_text(encoding="utf-8"))

    anime_sections = []
    total_characters = 0

    for anime in data.get("anime", []):
        character_rows = []
        valid_count = 0

        for character in anime.get("characters", []):
            folder = ROOT / character["folder"]
            index_page = folder / "index.html"
            versions_folder = folder / "Versions"

            if not index_page.exists():
                print(f"WARNING: Missing index.html: {folder}")
                continue

            checkpoints, artist, metadata = get_model_info(folder)

            checkpoint_text = (
                " / ".join(checkpoints) if checkpoints else "Unknown"
            )

            images = []
            if versions_folder.exists():
                images = sorted(
                    p for p in versions_folder.rglob("*")
                    if p.is_file() and p.suffix.lower()
                    in (".png", ".jpg", ".jpeg", ".webp")
                )

            preview_html = ""
            if images:
                image_url = local_url(images[0].relative_to(ROOT))
                preview_html = (
                    f'<img class="hover-preview" '
                    f'src="{escape(image_url, quote=True)}" '
                    f'alt="" loading="lazy">'
                )

            link = local_url(
                Path(character["folder"]) / "index.html"
            )

            search_text = (
                character["name"] + " " +
                anime["name"] + " " +
                checkpoint_text + " " + artist
            ).lower()

            character_rows.append(f"""
                <a class="character-row"
                   href="{escape(link, quote=True)}"
                   data-search="{escape(search_text, quote=True)}">

                    <span class="character-name">
                        {escape(character["name"])}
                    </span>

                    <span class="checkpoint">
                        {escape(checkpoint_text)}
                    </span>

                    <span class="artist">
                        {escape(artist)}
                    </span>

                    {preview_html}
                </a>
            """)

            valid_count += 1
            total_characters += 1

        if not character_rows:
            continue

        anime_sections.append(f"""
            <details class="anime-section">
                <summary>
                    <span class="anime-title">
                        {escape(anime["name"])}
                    </span>
                    <span class="count">
                        {valid_count}
                    </span>
                </summary>

                <div class="column-headings">
                    <span>Character Name</span>
                    <span>Checkpoints</span>
                    <span>Artist Name</span>
                </div>

                <div class="character-list">
                    {''.join(character_rows)}
                </div>
            </details>
        """)

    anime_options = "".join(
        f'<option value="{escape(anime["name"], quote=True)}"></option>'
        for anime in data.get("anime", [])
    )

    page = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>My Anime LoRA Library</title>

<style>
* {{
    box-sizing: border-box;
}}

body {{
    margin: 0;
    background: #17171d;
    color: #eeeeF4;
    font-family: Arial, sans-serif;
    font-size: 13px;
}}

header {{
    background: #22222b;
    padding: 18px 4%;
    border-bottom: 1px solid #383842;
}}

header h1 {{
    font-size: 22px;
    margin: 0 0 5px;
}}

header p {{
    color: #999;
    margin: 0;
    font-size: 12px;
}}

main {{
    max-width: 1500px;
    margin: auto;
    padding: 18px 4%;
}}

.library-stats {{
    color: #999;
    font-size: 11px;
    margin-bottom: 12px;
}}

.add-panel {{
    background: #22222b;
    border: 1px solid #49405c;
    border-radius: 7px;
    padding: 15px;
    margin-bottom: 18px;
}}

.add-panel h2 {{
    margin: 0 0 12px;
    font-size: 15px;
    color: #c9a7ff;
}}

.add-form {{
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 9px;
}}

.add-form input {{
    min-width: 0;
    padding: 10px;
    background: #17171d;
    border: 1px solid #494956;
    border-radius: 5px;
    color: white;
    font-size: 12px;
}}

.add-form button {{
    padding: 10px 15px;
    background: #68449a;
    border: none;
    border-radius: 5px;
    color: white;
    cursor: pointer;
    font-weight: bold;
    font-size: 12px;
}}

.add-form button:hover {{
    background: #8059b5;
}}

.add-form button:disabled {{
    opacity: .55;
    cursor: wait;
}}

#add-status {{
    margin-top: 10px;
    color: #aaa;
    font-size: 11px;
    white-space: pre-wrap;
}}

@media (max-width: 750px) {{
    .add-form {{
        grid-template-columns: 1fr;
    }}
}}

.search-box {{
    width: 100%;
    max-width: 420px;
    padding: 9px 12px;
    background: #252530;
    border: 1px solid #494956;
    border-radius: 5px;
    color: white;
    font-size: 12px;
    outline: none;
    margin-bottom: 16px;
}}

.search-box:focus {{
    border-color: #a77bea;
}}

.anime-section {{
    margin-bottom: 7px;
    background: #22222b;
    border: 1px solid #383842;
    border-radius: 5px;
    overflow: visible;
}}

.anime-section summary {{
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    user-select: none;
}}

.anime-section summary::-webkit-details-marker {{
    display: none;
}}

.anime-section summary::before {{
    content: "▶";
    color: #a77bea;
    font-size: 9px;
    transition: transform .15s;
}}

.anime-section[open] summary::before {{
    transform: rotate(90deg);
}}

.anime-section summary:hover {{
    background: #2b2935;
}}

.anime-title {{
    font-size: 13px;
    font-weight: bold;
}}

.count {{
    color: #b99ae8;
    background: #342b45;
    border-radius: 10px;
    padding: 2px 7px;
    font-size: 10px;
    margin-left: auto;
}}

.column-headings,
.character-row {{
    display: grid;
    grid-template-columns: minmax(140px, 1.1fr)
                           minmax(180px, 1.5fr)
                           minmax(100px, .8fr);
    gap: 12px;
    align-items: center;
}}

.column-headings {{
    padding: 6px 12px;
    color: #888;
    font-size: 10px;
    text-transform: uppercase;
    border-top: 1px solid #383842;
    border-bottom: 1px solid #383842;
}}

.character-list {{
    overflow: visible;
}}

.character-row {{
    position: relative;
    padding: 8px 12px;
    min-height: 32px;
    color: #ddd;
    text-decoration: none;
    border-bottom: 1px solid #30303a;
}}

.character-row:last-child {{
    border-bottom: none;
}}

.character-row:hover {{
    background: #302b3b;
}}

.character-name {{
    color: #c9a7ff;
    font-weight: bold;
}}

.checkpoint,
.artist {{
    color: #aaa;
    font-size: 11px;
}}

.hover-preview {{
    display: none;
    position: absolute;
    left: 100%;
    top: -35px;
    width: 170px;
    max-height: 220px;
    object-fit: contain;
    background: #17171d;
    border: 1px solid #a77bea;
    border-radius: 5px;
    padding: 3px;
    z-index: 100;
    box-shadow: 0 5px 20px #000a;
    pointer-events: none;
}}

.character-row:hover .hover-preview {{
    display: block;
}}

#empty-message {{
    display: none;
    color: #aaa;
    padding: 20px 0;
}}

footer {{
    text-align: center;
    padding: 18px;
    color: #666;
    border-top: 1px solid #30303a;
    font-size: 10px;
}}

@media (max-width: 650px) {{
    .column-headings,
    .character-row {{
        grid-template-columns: minmax(90px, 1fr)
                               minmax(100px, 1.2fr);
    }}

    .column-headings span:last-child,
    .character-row .artist {{
        display: none;
    }}

    .hover-preview {{
        left: auto;
        right: 5px;
    }}
}}
</style>
</head>

<body>

<header>
    <h1>My Anime LoRA Library</h1>
    <p>Personal Offline Collection</p>
</header>

<main>

    <section class="add-panel">
        <h2>+ Add a New Character</h2>

        <form class="add-form" id="add-character-form">
            <input
                type="url"
                id="civitai-url"
                placeholder="Paste Civitai model URL..."
                required
            >

            <input
                type="text"
                id="anime-title"
                list="anime-options"
                placeholder="Anime title (existing or new)..."
                required
            >

            <datalist id="anime-options">
                {anime_options}
            </datalist>

            <button type="submit" id="add-button">
                Add Character & Download
            </button>
        </form>

        <div id="add-status"></div>
    </section>

    <div class="library-stats">
        {len(anime_sections)} anime · {total_characters} characters
    </div>

    <input
        class="search-box"
        id="search"
        type="search"
        placeholder="Search anime, characters, checkpoints or artists..."
        oninput="filterLibrary()"
    >

    {''.join(anime_sections)}

    <div id="empty-message">
        No matching anime or characters found.
    </div>
</main>

<footer>Personal Offline LoRA Library</footer>

<script>
document.getElementById("add-character-form").addEventListener("submit", async function(event) {{
    event.preventDefault();

    const url = document.getElementById("civitai-url").value.trim();
    const anime = document.getElementById("anime-title").value.trim();
    const button = document.getElementById("add-button");
    const status = document.getElementById("add-status");

    button.disabled = true;
    button.textContent = "Downloading...";
    status.textContent = "Connecting to Civitai. The download may take some time...";

    try {{
        const response = await fetch("/add-character", {{
            method: "POST",
            headers: {{
                "Content-Type": "application/json"
            }},
            body: JSON.stringify({{ url, anime }})
        }});

        const result = await response.json();

        if (!response.ok || !result.success) {{
            throw new Error(result.error || "The operation failed.");
        }}

        status.textContent =
            "SUCCESS! " + result.model + "\\n" +
            "Anime: " + result.anime + "\\n" +
            "Versions: " + result.versions +
            " | Files: " + result.files +
            " | Images: " + result.images +
            " | Errors: " + result.errors +
            "\\nRefreshing the library...";

        setTimeout(() => window.location.reload(), 1800);

    }} catch (error) {{
        status.textContent = "ERROR: " + error.message;
        button.disabled = false;
        button.textContent = "Add Character & Download";
    }}
}});

function filterLibrary() {{
    const query = document.getElementById("search")
        .value.toLowerCase().trim();

    let visibleSections = 0;

    document.querySelectorAll(".anime-section").forEach(section => {{
        let visibleRows = 0;

        section.querySelectorAll(".character-row").forEach(row => {{
            const matches = row.dataset.search.includes(query);
            row.style.display = matches ? "grid" : "none";

            if (matches) visibleRows++;
        }});

        section.style.display = visibleRows ? "" : "none";
        section.open = query.length > 0 && visibleRows > 0;

        if (visibleRows) visibleSections++;
    }});

    document.getElementById("empty-message").style.display =
        visibleSections === 0 ? "block" : "none";
}}
</script>

</body>
</html>
"""

    output = ROOT / "index.html"
    output.write_text(page, encoding="utf-8")

    print("\n======================================")
    print("       LIBRARY GENERATED")
    print("======================================")
    print("Anime:", len(anime_sections))
    print("Characters:", total_characters)
    print("Output:", output.resolve())
    print("======================================")


if __name__ == "__main__":
    generate()